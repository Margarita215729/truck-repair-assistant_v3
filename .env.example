# ============================
# Truck Repair Assistant v3
# Environment Variables
# Copy this file to .env.local and fill in your values
# ============================

# --- Supabase (Client-side) ---
NEXT_PUBLIC_STORAGE_SUPABASE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Supabase (Server-side only — set in Vercel Environment Variables) ---
# Never prefix a server secret with VITE_ or NEXT_PUBLIC_.
STORAGE_SUPABASE_SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Stripe (Client-side) ---
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# Owner-Operator plan prices
VITE_OWNER_PRICE_MONTHLY=price_xxx
VITE_OWNER_PRICE_ANNUAL=price_xxx

# Fleet plan prices
VITE_FLEET_PRICE_MONTHLY=price_xxx
VITE_FLEET_PRICE_ANNUAL=price_xxx

# --- Stripe (Server-side only — set in Vercel Environment Variables) ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- AI / GitHub Models ---
# Server-side (secure — set in Vercel Environment Variables)
GITHUB_TOKEN=ghp_xxx

# Gemini only — service-account-bound key from Google Cloud (format: AQ.*)
# Do NOT use the general Maps/YouTube key here; Gemini will return 403.
GEMINI_API_KEY=your-gemini-service-account-key-here

# --- Brave Search API (for parts/forum search) ---
BRAVE_API_KEY=BSA_xxx

# --- Google Maps (server-side only — Geocoding and Places APIs) ---
# Never expose this key under a VITE_ or NEXT_PUBLIC_ name.
GOOGLE_MAPS_API_KEY=your-google-cloud-api-key-here

# --- Stripe Price IDs (server-side) ---
OWNER_PRICE_MONTHLY=price_xxx
OWNER_PRICE_ANNUAL=price_xxx
FLEET_PRICE_MONTHLY=price_xxx
FLEET_PRICE_ANNUAL=price_xxx

# --- Vendor APIs (server-side only) ---
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
FINDITPARTS_API_URL=
FINDITPARTS_API_KEY=

# --- Deployment (required for iOS/Android — API routes run on Vercel) ---
# Use the canonical URL (www) — apex redirects break Capacitor fetch/CORS on iOS.
NEXT_PUBLIC_BASE_URL=https://www.tra.tools
